{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexxus-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "mobile", "run", "web"],
      "port": 8081
    },
    {
      "name": "web-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "dashboard", "start"],
      "port": 3000
    },
    {
      "name": "framer-static",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "landing", "run", "dev"],
      "port": 8099
    },
    {
      "name": "framer-static-v2",
      "url": "http://localhost:8123"
    },
    {
      "name": "dashboard-build-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "dashboard", "exec", "--", "vite", "preview", "--port", "4174", "--strictPort"],
      "port": 4174
    }
  ]
}
