# Gitignored. Solo se carga con "npm start" (dev), nunca con "npm run build" (CRA no incluye
# .env.development.local en builds de producción) — ver nota en .env.local.
#
# En dev local, Expo (landing) corre en el puerto 8081 y este dashboard en el 3000: son orígenes
# distintos de verdad, así que el botón "volver a la landing" necesita la URL completa para
# navegar ahí (aunque la sesión de Firebase Auth NO se comparte entre orígenes distintos — eso es
# esperado en dev, solo en producción, mismo origen vía Firebase Hosting, sí se comparte).
REACT_APP_NEXXUS_LANDING_URL=http://localhost:8081/landing
