{
  "buildCommand": "npm --workspace dashboard run build && cp apps/dashboard/dist/index.html apps/dashboard/dist/app.html && cp apps/Landing/index.html apps/dashboard/dist/index.html",
  "outputDirectory": "apps/dashboard/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/app.html" },
    { "source": "/admin/(.*)", "destination": "/app.html" },
    { "source": "/workspace/(.*)", "destination": "/app.html" },
    { "source": "/landing", "destination": "/index.html" },
    { "source": "/landing/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
