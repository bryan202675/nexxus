{
  "buildCommand": "npm run build:hosting",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/workspace/(.*)", "destination": "/workspace/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/workspace/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
