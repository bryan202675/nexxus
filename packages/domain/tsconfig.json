{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "declaration": true,
    "declarationDir": "dist"
  },
  "include": ["entities", "errors", "repositories", "services", "application"],
  "exclude": ["dist"]
}
