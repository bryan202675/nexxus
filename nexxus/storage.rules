rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función de ayuda para validar autenticación
    function autenticado() {
      return request.auth != null;
    }
    
    // Solo permitimos lectura a usuarios autenticados para sus archivos
    match /usuarios/{userId}/{allPaths=**} {
      allow read: if autenticado();
      // Solo el usuario dueño de los archivos puede subir/actualizar
      allow write: if autenticado() && request.auth.uid == userId;
    }

    // Permitir lectura/escritura en la carpeta de perfiles
    match /perfiles/{userId}/{allPaths=**} {
      allow read: if autenticado();
      allow write: if autenticado() && request.auth.uid == userId;
    }

    // Regla global por defecto: bloquea todo lo demás para mantener máxima seguridad
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
