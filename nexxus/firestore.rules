rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function usuarioExiste() {
      return autenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function obtenerUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return usuarioExiste() ? obtenerUsuario().rol : "";
    }

    function esSuperAdmin() {
      return autenticado() &&
        (request.auth.token.rol == "super_admin" ||
         request.auth.token.role == "super_admin" ||
         rol() == "super_admin");
    }

    function esAdminEmpresa() {
      return esSuperAdmin() || rol() == "admin" || rol() == "admin_empresa";
    }

    function esJefe() {
      return esAdminEmpresa() || rol() == "jefe" || rol() == "jefe_sector";
    }

    function esPsicologo() {
      return rol() == "psicologo";
    }

    function mismaEmpresa(empresaId) {
      return esSuperAdmin() ||
        (usuarioExiste() &&
          (obtenerUsuario().empresaId == empresaId ||
           obtenerUsuario().empresa_id == empresaId));
    }

    function accesoEmpresa(empresaId) {
      return autenticado() && empresaId is string && mismaEmpresa(empresaId);
    }

    function docEmpresa() {
      return resource.data.empresaId is string
        ? resource.data.empresaId
        : resource.data.empresa_id;
    }

    function nuevoDocEmpresa() {
      return request.resource.data.empresaId is string
        ? request.resource.data.empresaId
        : request.resource.data.empresa_id;
    }

    function puedeLeerTenant(resourceData) {
      return esSuperAdmin() ||
        ((resourceData.empresaId is string && accesoEmpresa(resourceData.empresaId)) ||
         (resourceData.empresa_id is string && accesoEmpresa(resourceData.empresa_id)));
    }

    function puedeCrearTenant() {
      return nuevoDocEmpresa() is string && accesoEmpresa(nuevoDocEmpresa());
    }

    function mantieneTenant() {
      return puedeLeerTenant(resource.data) &&
        nuevoDocEmpresa() == docEmpresa();
    }

    function sinPasswordPlanoEnCreate() {
      return !request.resource.data.keys().hasAny(["passwordInterno", "passwordInicial"]);
    }

    function sinPasswordPlanoEnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["passwordInterno", "passwordInicial"]);
    }

    function sinEscalarSuperAdmin() {
      return !("rol" in request.resource.data) ||
        request.resource.data.rol != "super_admin" ||
        esSuperAdmin();
    }

    function usuarioAutoUpdateSeguro() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "nombre",
        "foto_hash",
        "foto_perfil",
        "fotoPerfil",
        "photoURL",
        "foto_public_id",
        "foto_size",
        "telefono",
        "estado_trabajo",
        "updatedAt",
        "fecha_actualizacion"
      ]);
    }

    function conversacionData(conversacionId) {
      return get(/databases/$(database)/documents/conversaciones/$(conversacionId)).data;
    }

    function participaEnConversacion(conversacionId) {
      return exists(/databases/$(database)/documents/conversaciones/$(conversacionId)) &&
        conversacionData(conversacionId).participanteIds.hasAny([request.auth.uid]);
    }

    function soloActualizaUltimoMensaje() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["ultimoMensaje", "ultimoMensajeAt"]);
    }

    function soloActualizaLecturaMensaje() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leidoPor"]) &&
        request.resource.data.leidoPor is list &&
        request.resource.data.leidoPor.hasAll(resource.data.leidoPor) &&
        request.resource.data.leidoPor.hasAny([request.auth.uid]);
    }

    match /usuarios/{userId} {
      allow get: if autenticado() && (
        request.auth.uid == userId ||
        esSuperAdmin() ||
        puedeLeerTenant(resource.data)
      );
      allow list: if autenticado() && (esSuperAdmin() || puedeLeerTenant(resource.data));
      allow create: if autenticado() && (
        request.auth.uid == userId ||
        (esAdminEmpresa() && puedeCrearTenant())
      ) && sinPasswordPlanoEnCreate() && sinEscalarSuperAdmin();
      allow update: if autenticado() && (
        esSuperAdmin() ||
        (request.auth.uid == userId && usuarioAutoUpdateSeguro()) ||
        (esAdminEmpresa() && mantieneTenant())
      ) && sinPasswordPlanoEnUpdate() && sinEscalarSuperAdmin();
      allow delete: if autenticado() && esSuperAdmin();

      match /{subcollection}/{docId} {
        allow read, write: if autenticado() && (
          request.auth.uid == userId ||
          esSuperAdmin() ||
          esAdminEmpresa()
        );
      }
    }

    match /empresas/{empresaId} {
      allow get, list: if autenticado() && (esSuperAdmin() || accesoEmpresa(empresaId));
      allow create: if autenticado() && (
        esSuperAdmin() ||
        request.resource.data.adminId == request.auth.uid
      );
      allow update: if autenticado() && (
        esSuperAdmin() ||
        (accesoEmpresa(empresaId) && esAdminEmpresa())
      );
      allow delete: if autenticado() && esSuperAdmin();
    }

    match /tareas/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.asignado_a == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update: if autenticado() && (
        (mantieneTenant() && esJefe()) ||
        resource.data.asignado_a == request.auth.uid
      );
      allow delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /solicitudes_ausencia/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.usuario_id == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.usuario_id == request.auth.uid;
      allow update: if autenticado() && (
        (mantieneTenant() && esJefe()) ||
        resource.data.usuario_id == request.auth.uid
      );
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa()) ||
        resource.data.usuario_id == request.auth.uid
      );
    }

    match /solicitudes_internas/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if autenticado() && (
        (mantieneTenant() && esJefe()) ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /reportes/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.empleadoId == request.auth.uid ||
        resource.data.creadoPor == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update: if autenticado() && mantieneTenant() && esJefe();
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /evaluaciones/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.empleadoId == request.auth.uid ||
        resource.data.evaluadorId == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update: if autenticado() && mantieneTenant() && esJefe();
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /asistencias/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /payments/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.usuario_id == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if autenticado() && (
        esSuperAdmin() ||
        (puedeCrearTenant() && esAdminEmpresa()) ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /planes/{id} {
      allow read: if autenticado();
      allow create, update, delete: if esSuperAdmin();
    }

    match /suscripciones/{id} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        accesoEmpresa(id) ||
        puedeLeerTenant(resource.data)
      );
      allow create, update: if autenticado() && (
        esSuperAdmin() ||
        (nuevoDocEmpresa() == id && esAdminEmpresa())
      );
      allow delete: if autenticado() && esSuperAdmin();
    }

    match /nominas/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.usuario_id == request.auth.uid ||
        resource.data.empleadoId == request.auth.uid
      );
      allow create, update, delete: if autenticado() && (
        esSuperAdmin() ||
        (puedeCrearTenant() && esAdminEmpresa()) ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /documentos/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() && esAdminEmpresa();
      allow update: if autenticado() && (
        resource.data.userId == request.auth.uid ||
        (mantieneTenant() && esAdminEmpresa())
      );
      allow delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /inventario_activos/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.asignadoA == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update: if autenticado() && mantieneTenant() && esJefe();
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /inventario_movimientos/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if false;
    }

    match /incidencias/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.reportadoPor == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.reportadoPor == request.auth.uid;
      allow update: if autenticado() && mantieneTenant() && esJefe();
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /archivos_cloudinary/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant();
      allow update: if autenticado() && mantieneTenant();
      allow delete: if false;
    }

    match /anuncios/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /conversaciones/{id} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        (puedeLeerTenant(resource.data) && (
          resource.data.participanteIds.hasAny([request.auth.uid]) ||
          esJefe()
        ))
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.participanteIds.hasAny([request.auth.uid]);
      allow update: if autenticado() && mantieneTenant() && (
        esJefe() ||
        resource.data.creadoPor == request.auth.uid ||
        (
          resource.data.participanteIds.hasAny([request.auth.uid]) &&
          soloActualizaUltimoMensaje()
        )
      );
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /mensajes/{id} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        (puedeLeerTenant(resource.data) && (
          participaEnConversacion(resource.data.conversacionId) ||
          esJefe()
        ))
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.remitenteId == request.auth.uid &&
        participaEnConversacion(request.resource.data.conversacionId);
      allow update: if autenticado() && mantieneTenant() && soloActualizaLecturaMensaje();
      allow delete: if autenticado() && (
        esSuperAdmin() ||
        (mantieneTenant() && esAdminEmpresa())
      );
    }

    match /notificaciones/{id} {
      allow read: if autenticado() && (
        resource.data.usuario_id == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        puedeLeerTenant(resource.data)
      );
      allow create: if autenticado() && puedeCrearTenant();
      allow update: if autenticado() && (
        ((resource.data.usuario_id == request.auth.uid || resource.data.userId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leida", "fechaLectura"])) ||
        (mantieneTenant() && esJefe())
      );
      allow delete: if autenticado() && (
        resource.data.usuario_id == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (mantieneTenant() && esJefe())
      );
    }

    match /push_tokens/{id} {
      allow read: if autenticado() && (
        resource.data.usuario_id == request.auth.uid ||
        esAdminEmpresa()
      );
      allow create: if autenticado() &&
        request.resource.data.usuario_id == request.auth.uid;
      allow update: if autenticado() && (
        resource.data.usuario_id == request.auth.uid ||
        esAdminEmpresa()
      );
      allow delete: if autenticado() &&
        resource.data.usuario_id == request.auth.uid;
    }

    match /audit_logs/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data) && esJefe();
      allow create: if autenticado() && puedeCrearTenant();
      allow update, delete: if false;
    }

    match /ai_usage/{id} {
      allow read: if autenticado() && (
        esSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (puedeLeerTenant(resource.data) && esJefe())
      );
      allow create, update, delete: if false;
    }

    match /backup_jobs/{id} {
      allow read: if autenticado() && esSuperAdmin();
      allow create, update, delete: if false;
    }

    match /support_sessions/{id} {
      allow read: if autenticado() && esSuperAdmin();
      allow create, update, delete: if false;
    }

    match /auth_rate_limits/{id} {
      allow read, write: if false;
    }

    match /ai_usage_daily/{id} {
      allow read: if autenticado() && esSuperAdmin();
      allow create, update, delete: if false;
    }

    match /plataforma_config/{id} {
      allow read: if autenticado() && esSuperAdmin();
      allow create, update, delete: if false;
    }

    match /sensitive_change_history/{id} {
      allow read: if autenticado() && (esSuperAdmin() || (puedeLeerTenant(resource.data) && esAdminEmpresa()));
      allow create, update, delete: if false;
    }

    match /logs/{id} {
      allow read: if autenticado() && (esSuperAdmin() || puedeLeerTenant(resource.data));
      allow create: if autenticado();
      allow update, delete: if false;
    }

    match /logs_auditoria/{id} {
      allow read: if autenticado() && (esSuperAdmin() || puedeLeerTenant(resource.data));
      allow create: if autenticado();
      allow update, delete: if false;
    }

    match /calendario_empresarial/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /sedes/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /departments/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /cargos/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /roles_personalizados/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esAdminEmpresa();
      allow update, delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /citas/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.usuario_id == request.auth.uid ||
        (esPsicologo() && resource.data.especialista == obtenerUsuario().nombre)
      );
      allow create: if autenticado() && puedeCrearTenant();
      allow update: if autenticado() && (
        (mantieneTenant() && esJefe()) ||
        resource.data.usuario_id == request.auth.uid ||
        (esPsicologo() && resource.data.especialista == obtenerUsuario().nombre)
      );
      allow delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /especialistas/{id} {
      allow read: if autenticado() && (esSuperAdmin() || puedeLeerTenant(resource.data));
      allow create: if autenticado() && puedeCrearTenant() && esJefe();
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /respuestas_formularios/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.usuario_id == request.auth.uid
      );
      allow create: if autenticado() &&
        request.resource.data.usuario_id == request.auth.uid;
      allow update, delete: if autenticado() && esAdminEmpresa();
    }

    match /inbox_unificado/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.userId == request.auth.uid ||
        resource.data.usuario_id == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant();
      allow update: if autenticado() && (
        mantieneTenant() ||
        resource.data.userId == request.auth.uid ||
        resource.data.usuario_id == request.auth.uid
      );
      allow delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /chat_contextual/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /checkins/{id} {
      allow read: if autenticado() && (
        puedeLeerTenant(resource.data) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if autenticado() && puedeCrearTenant() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /pausas/{id} {
      allow read: if autenticado() && resource.data.userId == request.auth.uid;
      allow create: if autenticado() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if autenticado() && resource.data.userId == request.auth.uid;
    }

    match /focus_sessions/{id} {
      allow read: if autenticado() && resource.data.userId == request.auth.uid;
      allow create: if autenticado() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if autenticado() && resource.data.userId == request.auth.uid;
    }

    match /feedbacks/{id} {
      allow read: if autenticado() && (
        resource.data.userId == request.auth.uid ||
        puedeLeerTenant(resource.data)
      );
      allow create: if autenticado() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if autenticado() && mantieneTenant() && esJefe();
    }

    match /cursos/{id} {
      allow read: if autenticado() && puedeLeerTenant(resource.data);
      allow create: if autenticado() && puedeCrearTenant() && esAdminEmpresa();
      allow update, delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /capacitacion_avances/{id} {
      allow read: if autenticado() && (
        resource.data.empleadoId == request.auth.uid ||
        puedeLeerTenant(resource.data)
      );
      allow create, update, delete: if false;
    }

    match /configuraciones_empresa/{id} {
      allow read: if autenticado() && (esSuperAdmin() || accesoEmpresa(resource.data.empresaId));
      allow create: if autenticado() && puedeCrearTenant() && esAdminEmpresa();
      allow update, delete: if autenticado() && mantieneTenant() && esAdminEmpresa();
    }

    match /upload_rate_limits/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{collection}/{document=**} {
      allow read, write: if false;
    }
  }
}
